{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://schemas.orbitchain.org/events/campaign_status_changed.json",
  "title": "OrbitChain Event: campaign_status_changed",
  "description": "Emitted by campaign status transitions. Topics vary by transition type.",
  "type": "object",
  "required": [
    "from",
    "to",
    "ledger"
  ],
  "properties": {
    "from": {
      "type": "string",
      "description": "Previous campaign status",
      "enum": ["Active", "GoalReached", "Ended", "Cancelled"]
    },
    "to": {
      "type": "string",
      "description": "New campaign status",
      "enum": ["Active", "GoalReached", "Ended", "Cancelled"]
    },
    "ledger": {
      "type": "integer",
      "description": "Ledger number at which the transition occurred",
      "format": "uint32",
      "minimum": 0
    }
  },
  "additionalProperties": false
}
